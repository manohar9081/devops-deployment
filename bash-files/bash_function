RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RESET='\033[0m'

shopt -s expand_aliases

# NOTE: `k8screds` is intentionally NOT defined here. The canonical alias
# lives in .bash_environment
# (`~/.local/bin/scripts/k8s/add_yaml_to_kconf.sh`) and points at $HOME, so it
# works on any host. Defining it again here used to shadow that with a
# hard-coded `/app/$(whoami)/...` path that only worked on one specific machine.

function kubectl_prompt_info() {
    local ctx=$(kubectx -c 2> /dev/null)
    local ns=$(kubens -c 2> /dev/null)
    echo -e "${RED}${ctx}${RESET}:${GREEN}${ns}${RESET}"
}

function git_branch_info() {
    local branch=$(git rev-parse --abbrev-ref HEAD 2> /dev/null)
    if [ -n "$branch" ]; then
        echo -e "${YELLOW}git:${branch}${RESET}"
    fi
}

function kctx() {
    #k8screds
    local context
    context=$(kubectx | fzf --height 40% --reverse --header "Select Kubernetes Context: " --exact)
    if [ -n "$context" ]; then
        kubectx "$context"
    fi
}

function kens() {
    local namespace
    namespace=$(kubens | fzf --height 40% --reverse --header "Select Kubernetes Namespace: " --exact)
    if [ -n "$namespace" ]; then
        kubens "$namespace"
    fi
}

k8s_version() {
  KUBECTL_VERSIONS_DIR="$HOME/.local/bin/kubectl-versions"
  KUBECTL_BIN="$HOME/.local/bin/kubectl"

  SELECTED_VERSION=$(ls "$KUBECTL_VERSIONS_DIR" | fzf --height 40% --reverse --header "Select Kubernetes Version: " --exact)
  echo "Creating symlink: $KUBECTL_BIN -> $KUBECTL_VERSIONS_DIR/$SELECTED_VERSION"
  ln -sf "$KUBECTL_VERSIONS_DIR/$SELECTED_VERSION" "$KUBECTL_BIN"
}

tf_version() {
  TERRAFORM_VERSIONS_DIR="$HOME/.local/bin/terraform-versions"
  TERRAFORM_BIN="$HOME/.local/bin/terraform"

  SELECTED_VERSION=$(ls "$TERRAFORM_VERSIONS_DIR" | fzf --height 40% --reverse --header "Select Terraform Version: " --exact)
  echo "Creating symlink: $TERRAFORM_BIN -> $TERRAFORM_VERSIONS_DIR/$SELECTED_VERSION"
  ln -sf "$TERRAFORM_VERSIONS_DIR/$SELECTED_VERSION" "$TERRAFORM_BIN"
}


aws_profile() {
    creds_dir="$HOME/awsconfig"

    select_profile=$(ls "$creds_dir"/*.txt | xargs -n 1 basename | sed 's/.txt$//' | fzf --height 40% --reverse --header "Select AWS Profile: " --exact)

    if [[ -z "$select_profile" ]]; then
        echo "No profile selected, Exiting..."
        return 1
    fi

    AWS_CURRENT_PROFILE=$(basename "$select_profile" .txt)

    echo "[default]" > "$HOME/.aws/credentials"

    tail -n +2 "$creds_dir/$select_profile.txt" >> "$HOME/.aws/credentials"

    chmod 600 "$HOME/.aws/credentials"
    echo "Copied keys to [default]."
    echo "Current AWS profile: $AWS_CURRENT_PROFILE"
}

function sso_login() {
    selected_profile=$(aws configure list-profiles | fzf --height 40% --reverse --prompt="Select AWS SSO Profile to login: " --exact)
    if [ -n "$selected_profile" ]; then
        echo "Logging into AWS SSO Profile: $selected_profile"
        aws sso login --profile "$selected_profile"
    else
        echo "No Profile Selected..."
    fi
}

function sso_profile() {
    sso_selected_profile=$(aws configure list-profiles | fzf --height 40% --reverse --prompt="Select Default AWS SSO Profile to be set to: " --exact)
    if [ -n "$sso_selected_profile" ]; then
        echo "Setting $sso_selected_profile as AWS DEFAULT SSO Profile"
        export AWS_PROFILE="$sso_selected_profile"
        SSO_CURRENT_PROFILE=${sso_selected_profile}
    else
        echo "No Profile Selected..."
    fi
}

function ssm_doc() {
    local ssm_doc
    ssm_doc=$(echo -e "devops-user-SSM-Document\nSSM-SessionManagerRunShell" | fzf --height 40% --reverse --prompt="Select AWS Document: " --exact)
    if [ -n "$ssm_doc" ]; then
        echo "$ssm_doc"
    fi
}

ssm_session() {
    if [ -z "$1" ]; then
        echo "Usage: ssm_session <instance-name>"
        return 1
    fi

    local doc
    doc=$(ssm_doc)

    echo "Using SSM Document: $doc"

    local instance_name="$1"
    local profile_name="$2"
    local region_name="$3"

    if [ -z "$profile_name" ]; then
        profile_name="default"
    fi
    if [ -z "$region_name" ]; then
        region_name="us-east-1"
    fi
    if [ -z "$doc" ]; then
        doc="default"
    fi

    export AWS_PROFILE="$profile_name"

    echo "Getting instance-id for '$instance_name'..."
    instance_id=$(aws ec2 describe-instances \
        --filters "Name=tag:Name,Values=$instance_name" \
        --query "Reservations[].Instances[].InstanceId" \
        --profile "$profile_name" \
        --region "$region_name" \
        --output text)

    if [ -z "$instance_id" ]; then
        echo "Error: Instance '$instance_name' not found in profile '$profile_name' in region 'us-east-1'."
        return 1
    fi

    echo "Getting instance '$instance_name' status..."
    instance_status=$(aws ec2 describe-instances \
        --instance-ids "$instance_id" \
        --region "$region_name" \
        --query "Reservations[].Instances[].State.Name" \
        --output text)
    if [ "$instance_status" == "running" ]; then
        echo "Instance is running, connecting to instance '$instance_name'..."
        aws ssm start-session \
            --target "$instance_id" \
            --document-name "$doc" \
            --profile "$profile_name" \
            --region "$region_name"
    elif [ "$instance_status" == "stopped" ]; then
        echo "Instance '$instance_name' is stopped..."
    else
        echo "Unable to get instance status..."
    fi
}
